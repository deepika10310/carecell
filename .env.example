# Local MySQL credentials. Do not use these defaults in production.
# The running instance uses the ignored .env file; rotate secrets before sharing this template.
MYSQL_ROOT_USER=root
MYSQL_ROOT_PASSWORD=change-me
MYSQL_DATABASE=carecell
MYSQL_USER=carecell_app
MYSQL_PASSWORD=change-this-local-password
JWT_SECRET_KEY=replace-with-a-long-random-secret-before-deploying

# S3 test-result storage. Use an IAM role or set local development credentials.
AWS_S3_BUCKET=your-private-carecell-test-results-bucket
AWS_REGION=us-east-1
# Floci is reached by its Compose service name from the backend container.
# Use http://localhost:4566 only when running the backend directly on the host.
AWS_S3_ENDPOINT_URL=http://floci:4566
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
