# External MySQL connection string. In Docker Compose, use host.docker.internal
# for a MySQL server running on this computer; use localhost when running the
# backend directly on the host. URL-encode reserved credential characters.
DATABASE_URL=mysql+pymysql://carecell_app:replace-me@host.docker.internal:3306/carecell?charset=utf8mb4
JWT_SECRET_KEY=replace-with-a-long-random-secret-before-deploying

# S3 test-result storage. Use an IAM role or set local development credentials.
AWS_S3_BUCKET=your-private-carecell-test-results-bucket
AWS_REGION=us-east-1
# Floci is reached by its Compose service name from the backend container.
# Use http://localhost:4566 only when running the backend directly on the host.
AWS_S3_ENDPOINT_URL=http://floci:4566
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# AI chat uses an OpenAI-compatible Chat Completions API. Keep the key server-side.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=60

# Set true to route AI chat through Hugging Face Inference Providers.
HUGGING_FACE_FLAG=false
HUGGING_FACE_TOKEN=
HUGGING_FACE_BASE_URL=https://router.huggingface.co/v1
HUGGING_FACE_MODEL=Qwen/Qwen2.5-7B-Instruct
